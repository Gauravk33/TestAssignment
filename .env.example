# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_PORT=3000

# Database & Cache (Set to your MongoDB Atlas and Upstash / local URLs)
MONGO_URI=mongodb://localhost:27017/teamspace
REDIS_URI=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=teamspace_jwt_access_secret_key_2026_super_secure
JWT_REFRESH_SECRET=teamspace_jwt_refresh_secret_key_2026_super_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
